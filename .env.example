# Copy to .env for docker compose. Generate secrets with: openssl rand -hex 32
CASHR_NETWORK=main
CASHR_WALLET_RPC_PASSWORD=
# Encrypts every event's seed at rest. Back it up separately from the wallet volume.
CASHR_WALLET_SEED_KEY=
CASHR_CORS_ORIGINS=https://your-cashr.netlify.app
# Local port the API listens on (behind your HTTPS proxy). Change it if 8000 is taken.
# CASHR_API_PORT=8000
# Public hostname for the API (profile "https"), e.g. api.example.com or 203-0-113-7.sslip.io
API_DOMAIN=
# CASHR_WALLET_LIGHTWALLETD=https://zec.rocks:443
# The wallet reaches lightwalletd through the bundled Tor service. Leave it empty
# to connect directly (lightwalletd's operator then sees this server's address).
# CASHR_WALLET_SOCKS_PROXY=tor:9050
# Public listing and refunds (privacy): the public list updates at random moments,
# refunds go out one per transaction at random times within the spread. After
# settling, no-show deposits wait the door-sync grace for offline door phones.
# CASHR_LIST_DELAY_MIN=120
# CASHR_REFUND_SPREAD_MIN=180
# CASHR_DOOR_SYNC_GRACE_MIN=30
# Pin both images to one commit (default: the latest main).
# CASHR_TAG=
# Nightly encrypted backups (deploy/backup.sh). Keep the passphrase offline too.
CASHR_BACKUP_PASSPHRASE=
# CASHR_BACKUP_REMOTE=user@host:/srv/cashr-backups
# Optional demo API on a simulated chain: add it to every compose command.
# COMPOSE_PROFILES=demo
# CASHR_DEMO_CORS_ORIGINS=https://demo.cashr.site
