# Copy to .env for docker compose. Generate secrets with: openssl rand -hex 32
CASHR_NETWORK=main
CASHR_SECRET=
CASHR_WALLET_RPC_PASSWORD=
# Encrypts every event's seed at rest. Back it up separately from the wallet volume.
CASHR_WALLET_SEED_KEY=
CASHR_CORS_ORIGINS=https://your-cashr.netlify.app
# Local port the API listens on (behind your HTTPS proxy). Change it if 8000 is taken.
# CASHR_API_PORT=8000
# Public hostname for the API (profile "https"), e.g. api.example.com or 203-0-113-7.sslip.io
API_DOMAIN=
# CASHR_WALLET_LIGHTWALLETD=https://zec.rocks:443
# The wallet reaches lightwalletd through the bundled Tor service. Leave it empty
# to connect directly (lightwalletd's operator then sees this server's address).
# CASHR_WALLET_SOCKS_PROXY=tor:9050
# Used refund addresses are refused for one to two periods of this many days.
# CASHR_ADDRESS_MEMORY_DAYS=365
