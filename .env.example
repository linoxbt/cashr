# Copy to .env for docker compose. Generate secrets with: openssl rand -hex 32
UNLISTED_NETWORK=main
UNLISTED_SECRET=
UW_RPC_PASSWORD=
# Encrypts every event's seed at rest. Back it up separately from the wallet volume.
UW_SEED_KEY=
UNLISTED_CORS_ORIGINS=https://your-unlisted.netlify.app
# Public hostname for the API (profile "https"), e.g. api.example.com or 203-0-113-7.sslip.io
API_DOMAIN=
# UW_LIGHTWALLETD=https://zec.rocks:443
